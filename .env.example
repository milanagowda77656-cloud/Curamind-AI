# =============================================================
#  CuraMind AI - Environment Configuration
#  Copy this file to .env and fill in your values
# =============================================================

# --- Django Core ---
SECRET_KEY=your-very-long-random-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=curamind_db
DB_USER=curamind_user
DB_PASSWORD=your_db_password
DB_HOST=db
DB_PORT=5432

# --- Redis (for Celery + Caching) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Email (SMTP for notifications) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# --- AWS S3 (for HIPAA-compliant file storage) ---
# Set USE_S3=True in production; False uses local filesystem
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=curamind-medical-images
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=your-bucket.s3.amazonaws.com

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Encryption Key (for encrypting patient data at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# --- Frontend URL (for password reset emails, etc.) ---
FRONTEND_URL=http://localhost:8000
